@startuml workflow-fix
' The fix lane: a defect or small change tracked as a GitHub issue.
'
' One of three lane diagrams (feature, work package, fix). The branches
' each step works on are in docs/development/branching-model.puml.
' The pre-commit hook renders the PNG for any staged .puml automatically;
' render the PDF with `plantuml -tpdf docs/development/workflow-fix.puml`.

title The fix lane

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam ArrowFontSize 10
skinparam ArrowFontColor #666666

skinparam rectangle {
  BorderColor #999999
  BackgroundColor #FFFFFF
  FontSize 12
  roundCorner 8
}
skinparam package {
  BorderColor #BBBBBB
  BackgroundColor #FAFAFA
  FontColor #777777
  FontSize 11
  FontStyle plain
}

package "Capture" {
  rectangle "**GitHub issue**\nraised by hand, by a brief\nthrough {{SKILL_PREFIX}}-review-session-notes,\nor by a QA sweep" as issue
}

package "Where does it belong?" {
  rectangle "**{{SKILL_PREFIX}}-fix-branch**\none issue or several, one target;\nlists the open feature/* branches,\nmain last; the operator chooses;\nthe target is recorded on each issue" as fixskill #F0F6FF
}

package "Fix for a feature in flight" {
  rectangle "**fix/N-slug**\ncut from feature/..." as ffix
  rectangle "**{{SKILL_PREFIX}}-merge**, task merge\nchecks (task tier) green,\nno pest on the fix branch" as ftask #F0F6FF
  rectangle "**feature/...**\nthe fix rides with the feature" as feat #F0F6FF
  rectangle "**{{SKILL_PREFIX}}-merge**, feature merge\npest over everything,\nthe fix included" as featmerge #F0F6FF
}

package "Production fix, no owning feature" {
  rectangle "**fix/N-slug**\ncut from main;\nbatch several fixes to\npay for one pest run" as pfix #FFF0F0
  rectangle "**{{SKILL_PREFIX}}-merge**, direct merge\nfull checks, pest **mandatory**:\nnothing later catches it" as pmerge #F0F6FF
}

package "Release" {
  rectangle "**main**" as main
  rectangle "**release-please PR**\nmerging it publishes the\nrelease and fires the deploy" as release
  rectangle "**Live**" as live #F0FFF0
}

issue --> fixskill
fixskill --> ffix : a feature branch
fixskill --> pfix : main
ffix --> ftask
ftask --> feat
feat --> featmerge
featmerge --> main
pfix --> pmerge
pmerge --> main
main --> release
release --> live

note right of feat
  GitHub closes an issue only on a
  merge to main, so "Fixes #N" on a
  fix into a feature branch closes
  it when the feature merges.
end note

@enduml
