# Local environment template.
#
# Copy to .env (untracked) and fill in, or run `make env-sync` to line an
# existing .env up with this file. Keys are grouped by what they do; the
# config file that reads each group is named in its heading. Conventions:
#
#   KEY=value      set in a fresh clone; the value shown boots the stack.
#   # KEY=value    carries its code default. Uncomment only to override.
#   KEY=           deliberately blank; the code falls back safely on "".
#
# dotenv takes the LAST definition of a key, so a commented override block
# must be uncommented in place and its counterpart commented out, never
# appended at the end of the file where it silently wins.
#
# Real secrets never go in this file. Production values are rendered from
# the deployment's own secret store.

# =============================================================================
# 1. Application (config/app.php)
# =============================================================================

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# 2. Local Docker stack (Sail, compose.yaml)
# =============================================================================

# Host-port bindings. Pick one three-digit suffix per project (100 here) so
# several local Docker apps can share the same 8xxx/5xxx/33xxx/63xxx scheme
# without clashing.
APP_PORT=8100
VITE_PORT=5100
FORWARD_DB_PORT=33100
FORWARD_REDIS_PORT=63100

# Sail passes these through to the app container. Leave unset unless file
# ownership inside the container is wrong or Xdebug is needed.
# WWWUSER=1000
# WWWGROUP=1000
# SAIL_XDEBUG_MODE=off
# SAIL_XDEBUG_CONFIG="client_host=host.docker.internal"
# MYSQL_EXTRA_OPTIONS=

# =============================================================================
# 3. Hostnames and sessions (config/app.php, config/session.php)
# =============================================================================
#
# A fresh clone runs on http://localhost:8100 with no DNS and no
# certificates. Browsing over real HTTPS hostnames is section 4.

APP_URL=http://localhost:8100

# SESSION_SECURE_COOKIE only once plain http://localhost is genuinely no
# longer used: a secure cookie is not sent over plain HTTP, and login there
# will simply stop working.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true

# =============================================================================
# 4. Local HTTPS front door (Caddy, compose.yaml, docker/caddy/)
# =============================================================================
#
# The `caddy` service terminates TLS on 443 for CADDY_BASE_DOMAIN and its
# wildcard and proxies to the app container. http://localhost:8100 keeps
# working alongside it.
#
# The base domain is PER MACHINE. Two machines must never share a public
# zone: DNS can only point at one of them, and both would fight over the
# same Let's Encrypt wildcard.
#
# CADDY_TLS_MODE:
#   internal  Caddy's own local CA. The default, and the only mode that
#             works with no AWS credentials. Browsers warn unless the local
#             root is trusted. Needs an /etc/hosts entry for the base domain.
#   route53   Let's Encrypt wildcard over the ACME DNS-01 challenge. Needs
#             the CADDY_AWS_* credentials, from an IAM user scoped to THIS
#             machine's hosted zone only. Deliberately separate variables
#             from the application's own AWS_* credentials in section 8:
#             never point them at the same user.
CADDY_BASE_DOMAIN=app.test
CADDY_TLS_MODE=internal
CADDY_ACME_EMAIL=
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_AWS_ACCESS_KEY_ID=
CADDY_AWS_SECRET_ACCESS_KEY=
CADDY_AWS_REGION=eu-west-1

# ---- HTTPS-only override set --------------------------------------------
# To move a machine entirely onto its Caddy hostname, set these in place of
# their counterparts above. Replace <base> with this machine's zone.
#
# APP_URL=https://<base>
# CADDY_BASE_DOMAIN=<base>
#
# Behind Caddy, Laravel must also trust the proxy's X-Forwarded-Proto
# (bootstrap/app.php, ->trustProxies()), or it writes http:// URLs into an
# https:// page.

# =============================================================================
# 5. Database, cache and queue (config/database.php, config/queue.php)
# =============================================================================
#
# MySQL everywhere, including tests (phpunit.xml uses the `testing`
# database Sail creates). Never sqlite.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
MEMCACHED_HOST=127.0.0.1

# =============================================================================
# 6. Logging (config/logging.php)
# =============================================================================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# 7. Mail (config/mail.php)
# =============================================================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# 8. AWS (application credentials, config/filesystems.php, config/services.php)
# =============================================================================
#
# The application's own credentials. Never the Caddy DNS user in section 4.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# 9. Developer tooling
# =============================================================================
#
# PlantUML jar used to render data-model.puml during the spec-kit plan phase
# (baked into the Sail image by docker/php85/Dockerfile).
# PLANTUML_JAR_PATH=/usr/share/plantuml/plantuml.jar
